# Copy to .env and uncomment to override defaults.
# just and load-rotelle.sh both read these.

# Docker image name and tag (defaults to rotelle:dev if unset)
# ROTELLE_IMAGE=rotelle:dev

# Target CPU architecture for the musl cross-compile.
# Auto-detected from `uname -m` when unset.
# aarch64  — Apple Silicon (macOS) or ARM64 Linux
# x86_64   — Intel/AMD (macOS or Linux)
# ROTELLE_MUSL_ARCH=aarch64
